[sub_resource type="GDScript" id="GDScript_074og"]
script/source = "extends Node2D
var z

var ennemies

func game_won():
	$\"CanvasLayer/game end screen\".show()
	$\"CanvasLayer/game end screen/PanelContainer/MarginContainer/you won\".show()
func game_lost():
	$\"CanvasLayer/game end screen\".show()
	$\"CanvasLayer/game end screen/PanelContainer/MarginContainer/you lost\".show()
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	$\"CanvasLayer/game end screen\".hide()
	$\"CanvasLayer/game end screen/PanelContainer/MarginContainer/you won\".hide()
	$\"CanvasLayer/game end screen/PanelContainer/MarginContainer/you lost\".hide()
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	ennemies = get_tree().get_nodes_in_group(\"ennemies\")
	z = 0
	for i in ennemies:
		z += 1
	if ennemies == []:
		game_won()
"

