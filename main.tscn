[sub_resource type="GDScript" id="GDScript_qq81q"]
script/source = "extends CharacterBody2D

@onready var  animation = $\"player image\"
const SPEED = 200.0
const JUMP_VELOCITY = -700.0
const acceleration = 0.001
var children = [$\"player image\", $\"player hitbox\", $\"player attack range\"]
var health = 100
var strength = 10
var attack_cooldown = 0
var ennemies_in_range
#direction is used for flipping the player if he goes to the left
var dir_right = true
# mode is used for keeping track which mode the player was in before attacking
var mode = \"idle\"
var last_mode = \"walking\"
var not_attacking = true
var damage_timer = 0

func move_towards_geometric(from, to, how_much):
	return((from-to)*how_much+to)

func attack():
	ennemies_in_range = $\"player attack range\".get_overlapping_bodies()
	for i in ennemies_in_range:
		if i.is_in_group(\"ennemies\"):
			i.take_damage(strength, dir_right)

	animation.play(\"attack\")

func take_damage(damage, direction):
	health -= damage
	velocity[0] += 60 * damage * (1 if direction else -1)
	self.modulate = Color(1, 0.5, 0.5)
	damage_timer = 0.3
	
func abilities(_delta: float):
	if Input.is_action_just_pressed(\"attack\") and attack_cooldown == 0:
		attack()
		attack_cooldown = 0.6
	if health <= 0:
		print(\"player died\")
		$\"..\".game_lost()

func abilities_reset(delta: float):
	if attack_cooldown > delta:
		attack_cooldown -= delta
	else:
		attack_cooldown = 0
		animation.play(mode)
	if damage_timer < delta:
		damage_timer = 0
		self.modulate = Color(1, 1, 1)
	else: 
		damage_timer -= delta

func _physics_process(delta: float) -> void:
	 #Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = JUMP_VELOCITY


	if Input.is_action_pressed(\"left\") and Input.is_action_pressed(\"right\"):
		velocity.x = move_towards_geometric(velocity.x, 0, acceleration**delta)
		mode = \"idle\"
	elif Input.is_action_pressed(\"left\") and Input.is_action_pressed(\"run\"):
		velocity.x = move_towards_geometric(velocity.x, 2*-SPEED, acceleration**delta)
		mode = \"running\"
	elif Input.is_action_pressed(\"left\"):
		velocity.x = move_towards_geometric(velocity.x, -SPEED, acceleration**delta)
		mode = \"walking\"
	elif Input.is_action_pressed(\"right\") and Input.is_action_pressed(\"run\"):
		velocity.x = move_towards_geometric(velocity.x, 2*SPEED, acceleration**delta)
		mode = \"running\"
	elif Input.is_action_pressed(\"right\"):
		velocity.x = move_towards_geometric(velocity.x, SPEED, acceleration**delta)
		mode = \"walking\"
	elif is_on_floor():
		velocity.x = move_toward(velocity.x, 0, acceleration**delta)
		
	if Input.is_action_just_pressed(\"left\") and dir_right:
		scale[0] = -1
		dir_right = false
	if Input.is_action_just_pressed(\"right\")and not dir_right:
		scale[0] = -1
		dir_right = true
	
	if abs(velocity[0]) < 100:
		mode = \"idle\"
	elif abs(velocity[0]) < 300:
		mode = \"walking\"
	elif abs(velocity[0]) < 500:
		mode = \"running\"

	move_and_slide()

func animate_character():
	
	not_attacking = attack_cooldown == 0
	if not_attacking and not last_mode == mode:
		animation.play(mode)
	last_mode = mode
	
		
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	abilities(delta)
	abilities_reset(delta)
	
"

