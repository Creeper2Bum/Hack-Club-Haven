[sub_resource type="GDScript" id="GDScript_egrb2"]
script/source = "extends CharacterBody2D

@onready var rat_animation = $\"rat image\"
var health = 30
var dir_right = false
var last_dir_right = true
var attack_cooldown = 0
var still_atacking = false
var mode = \"idle\"
var mode_last
var animation_finished = true
var animation_finished_last = true
var player_in_range = false
var attack_now = false
var attack_now_last = false
var is_dying = false
var damage_timer = 0
const SPEED = 200
const accelleration = 400
const strength = 10



func take_damage(damage, direction):
	health -= damage
	velocity[0] += 20 * damage *(1 if direction else -1)
	self.modulate = Color(1, 0.5, 0.5)
	damage_timer = 0.3
	
func _physics_process(delta: float) -> void:
	 #Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
	if dir_right != last_dir_right:
		scale.x = -1
	last_dir_right = dir_right
	move_and_slide()
	
func go_to_player(delta):
	if is_on_floor():
		var pos_rat = self.position.x
		var pos_player = $\"../../player\".position.x
		if abs(pos_rat-pos_player) > 500:
			mode = \"idle\"
			velocity.x = move_toward(velocity.x, 0, accelleration*delta)
		elif pos_rat < pos_player:
			dir_right = true
			mode = \"walking\"
			velocity.x = move_toward(velocity.x, SPEED, accelleration*delta)
		elif pos_rat > pos_player:
			dir_right = false
			mode = \"walking\"
			velocity.x = move_toward(velocity.x, -SPEED, accelleration*delta)
		else:
			velocity.x = move_toward(velocity.x, 0, accelleration*delta)

func player_in_range_func():
	player_in_range = false
	for i in $\"rat attack range\".get_overlapping_bodies():
		if i.is_in_group(\"player\"):
			player_in_range = true

func attack():
	if attack_cooldown <= 0 and player_in_range:

		attack_cooldown = 2
		rat_animation.play(\"attack\")
		
func abilities():
	attack_now = attack_cooldown < 1.65
	if attack_now and not attack_now_last and player_in_range:
		%player.take_damage(strength,dir_right)
	attack_now_last = attack_now
	if health <= 0:
		dying()

func animation():
	animation_finished = attack_cooldown < 1.2
	if animation_finished and not animation_finished_last:
		rat_animation.play(mode)
		
		
	if animation_finished and (mode_last != mode or not animation_finished):
		rat_animation.play(mode)
		
func abilities_reset(delta):
	if attack_cooldown < delta:
		attack_cooldown = 0
	else:
		attack_cooldown -= delta
	if damage_timer < delta:
		damage_timer = 0
		self.modulate = Color(1, 1, 1)
	else:
		damage_timer -= delta
	
func dying():
	self.modulate = Color(1, 1, 1, 0.85)
	mode = \"dying\"
	rat_animation.play(mode)
	set_physics_process(false)
	$\"rat hitbox\".disabled = true
	is_dying = true
	print(self)
	remove_from_group(\"ennemies\")

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if not is_dying:
		
		go_to_player(delta)
		attack()
		abilities()
		animation()
		abilities_reset(delta)
		player_in_range_func()
	


	
	
"

